<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title data-i18n="page_title">Statistika Grafiki</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        /* Umumiy Ranglar va O'zgaruvchilar */
        :root { --bg-body: #0a192f; --bg-sidebar: #112240; --bg-header: #112240; --card-bg: #1e293b; --text-main: #ccd6f6; --text-muted: #8892b0; --accent: #64ffda; --border-color: #233554; --danger: #ef4444; }
        [data-theme="light"] { --bg-body: #f1f5f9; --bg-sidebar: #ffffff; --bg-header: #ffffff; --card-bg: #ffffff; --text-main: #0f172a; --text-muted: #64748b; --accent: #3b82f6; --border-color: #e2e8f0; }

        body { margin: 0; font-family: 'Segoe UI', sans-serif; background: var(--bg-body); color: var(--text-main); display: flex; height: 100vh; overflow: hidden; transition: 0.3s; }
        
        /* KOMPYUTER EKRANI UCHUN MENYU (YON PANEL) */
        .sidebar { width: 260px; background: var(--bg-sidebar) !important; border-right: 1px solid var(--border-color); display: flex; flex-direction: column; transition: 0.3s; z-index: 1000; flex-shrink: 0; }
        .sidebar-header { padding: 20px; font-size: 20px; font-weight: bold; color: var(--text-main); display: flex; align-items: center; gap: 10px; border-bottom: 1px solid var(--border-color); }
        .nav-menu { display: flex; flex-direction: column; margin-top: 20px; }
        .nav-item { padding: 12px 20px; display: flex; align-items: center; gap: 15px; color: var(--text-muted); text-decoration: none; font-size: 16px; transition: 0.3s; cursor: pointer; border-left: 3px solid transparent; }
        .nav-item i { width: 20px; text-align: center; }
        .nav-item.active, .nav-item:hover { background: rgba(100, 255, 218, 0.1); color: var(--accent); border-left-color: var(--accent); }
        
        .main-content { flex: 1; display: flex; flex-direction: column; overflow-y: auto; z-index: 10; background: transparent; }
        
        /* HEADER QISMI */
        .header { height: 70px; background-color: var(--bg-header) !important; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center; padding: 0 30px; transition: 0.3s; flex-shrink: 0; }
        .header-controls { display: flex; align-items: center; gap: 20px; }

        /* GRAFIK QISMI CSS */
        .content-body { padding: 30px; width: 100%; box-sizing: border-box; max-width: 1200px; margin: 0 auto; }
        .chart-card { background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 10px; padding: 25px; margin-bottom: 20px; width: 100%; box-sizing: border-box; }
        
        /* Kompyuter ekranlarida mobil tugmalarni yashirish */
        @media (min-width: 769px) {
            #mobile-menu-btn { display: none !important; }
            .mobile-only-profile { display: none !important; }
        }

        /* ====================================================
           TELEFON EKRANLARI UCHUN YAKUNIY MOSLASHUV CSS
           ==================================================== */
        @media (max-width: 768px) {
            body { flex-direction: column; overflow-y: auto; }
            
            /* Tepadagi ortiqcha tugmalarni yashirish */
            .header-controls { display: none !important; }
            .header { padding: 15px; height: auto; }
            
            /* YAGONA 3 ta chiziqchali tugma (Ekranda qotib turadigan) */
            #mobile-menu-btn {
                display: inline-block !important;
                position: fixed !important; 
                top: 15px;
                right: 20px;
                font-size: 28px;
                background: transparent;
                border: none;
                color: var(--text-main);
                z-index: 10001; 
                cursor: pointer;
            }
            
            /* Menyuni O'NG tomondan chiqarish */
            .sidebar {
                position: fixed !important;
                right: -100% !important; 
                left: auto !important; 
                top: 0 !important;
                width: 280px !important;
                height: 100vh !important;
                background-color: var(--bg-sidebar) !important;
                transition: all 0.3s ease !important;
                z-index: 10000 !important;
                box-shadow: -5px 0 15px rgba(0,0,0,0.5);
                border-right: none;
            }

            .sidebar.active { right: 0 !important; }

            .nav-menu { display: flex !important; flex-direction: column !important; width: 100% !important; margin-top: 0 !important; padding: 0 !important; }
            .nav-item { display: flex !important; align-items: center !important; padding: 15px 20px !important; width: 100% !important; box-sizing: border-box !important; border-left: 3px solid transparent !important; border-bottom: none !important; }
            .nav-item.active, .nav-item:hover { border-left-color: var(--accent) !important; }

            .content-body { padding: 15px; }
            .chart-card { padding: 15px; }
            h3 { font-size: 16px; margin-top: 0; }
        }
    </style>
</head>
<body>
    
    <!-- MOBIL EKRAN UCHUN YAGONA TUGMA -->
    <button id="mobile-menu-btn">&#9776;</button>

    <!-- ASOSIY VA YAGONA YON MENYU -->
    <div class="sidebar">
        <!-- 1. Menyu Sarlavhasi -->
        <div class="sidebar-header" style="padding: 20px; border-bottom: 1px solid var(--border-color);">
            <span>
                <i class="fas fa-shield-halved" style="color: var(--danger); margin-right: 10px;"></i> 
                <span data-i18n="portal_name">KIBER PORTAL</span>
            </span>
        </div>
        
        <!-- 2. Profil rasmi va ism (Faqat telefonda ko'rinadi) -->
        <div class="mobile-only-profile" style="padding: 20px; border-bottom: 1px solid var(--border-color); display: flex; align-items: center; gap: 15px; background: rgba(0,0,0,0.15);">
            <div style="width: 45px; height: 45px; border-radius: 50%; background: #2c3e50; display: flex; align-items: center; justify-content: center;">
                <% if (typeof user !== 'undefined' && user && user.avatar) { %>
                    <img src="<%= user.avatar %>" style="width:100%; height:100%; border-radius:50%; object-fit:cover;">
                <% } else { %>
                    <i class="fas fa-user-shield" style="color: var(--accent); font-size: 22px;"></i>
                <% } %>
            </div>
            <div>
                <div style="font-weight: bold; color: var(--text-main); font-size: 16px;">
                    <%= (typeof user !== 'undefined' && user) ? user.username : 'Admin' %>
                </div>
                <div style="font-size: 12px; color: var(--accent);" data-i18n="<%= (typeof user !== 'undefined' && user && user.role === 'admin') ? 'role_admin' : 'role_user' %>">
                    <%= (typeof user !== 'undefined' && user && user.role === 'admin') ? 'Administrator' : 'Foydalanuvchi' %>
                </div>
            </div>
        </div>

        <!-- 3. Bo'limlar ro'yxati -->
        <div class="nav-menu">
            <a href="/dashboard" class="nav-item"><i class="fas fa-chart-line"></i> <span data-i18n="nav_dashboard">Bosh panel</span></a>
            <a href="/analytics" class="nav-item active"><i class="fas fa-chart-area"></i> <span data-i18n="nav_analytics">Statistika</span></a>
            <a href="/notifications" class="nav-item"><i class="fas fa-bell"></i> <span data-i18n="nav_notifications">Bildirishnomalar</span></a>
            
            <% if (typeof user !== 'undefined' && user && user.role === 'admin') { %>
                <a href="/admin/add-user" class="nav-item"><i class="fas fa-user-plus"></i> <span data-i18n="nav_add_user">Foydalanuvchi qo'shish</span></a>
            <% } %>
            
            <a href="/settings" class="nav-item"><i class="fas fa-user-cog"></i> <span data-i18n="nav_settings">Profil Sozlamalari</span></a>
            <a href="/sessions" class="nav-item"><i class="fas fa-laptop-house"></i> <span data-i18n="nav_sessions">Faol Qurilmalar</span></a>
            
            <!-- 4. Chiqish tugmasi -->
            <a href="/logout" class="nav-item mobile-only-profile" style="color: var(--danger); border-top: 1px solid var(--border-color); margin-top: 10px;">
                <i class="fas fa-sign-out-alt"></i> <span data-i18n="nav_logout">Chiqish</span>
            </a>
        </div>
    </div>

    <!-- ASOSIY QISM -->
    <div class="main-content">
        <div class="header">
            <div style="font-weight: bold;"><i class="fas fa-lock" style="color:#8b5cf6;"></i> <span data-i18n="platform_title">LoginGuard Platformasi</span></div>
            <div class="header-controls">
                <select id="languageSelect" onchange="changeLanguage(this.value)" style="background:var(--card-bg); color:var(--text-main); border:1px solid var(--border-color); border-radius:4px; outline:none; padding: 5px; cursor:pointer;">
                    <option value="uz">UZB</option>
                    <option value="en">ENG</option>
                    <option value="ru">RUS</option>
                </select>
                <a href="/dashboard" style="color:var(--accent); text-decoration:none; font-weight: bold;">
                    <i class="fas fa-arrow-left"></i> <span data-i18n="btn_back">Ortga qaytish</span>
                </a>
            </div>
        </div>
        
        <div class="content-body">
            <div class="chart-card">
                <h3><i class="fas fa-chart-area" style="color: var(--accent);"></i> <span data-i18n="chart_heading">Kirishlar Statistikasi (Oxirgi 7 kun)</span></h3>
                
                <!-- Canvas konteyneri -->
                <div style="position: relative; height: 50vh; width: 100%;">
                    <canvas id="cyberChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Ma'lumotlarni Chart.js uchun yuklash -->
    <div id="chart-data" data-logs='<%- JSON.stringify(typeof logs !== "undefined" ? logs : []) %>' data-failed='<%- JSON.stringify(typeof failedLogs !== "undefined" ? failedLogs : []) %>'></div>

    <!-- SCRIPT QISMLARI -->
    <script>
        // Mavzuni (Dark/Light) localStorage'dan o'qib olish
        document.documentElement.setAttribute('data-theme', localStorage.getItem('theme') || 'dark');

        // ------------------------------------------
        // TARJIMALAR LUG'ATI
        // ------------------------------------------
        const translations = {
            uz: {
                page_title: "Statistika Grafiki",
                portal_name: "KIBER PORTAL",
                role_admin: "Administrator",
                role_user: "Foydalanuvchi",
                nav_dashboard: "Bosh panel",
                nav_analytics: "Statistika",
                nav_notifications: "Bildirishnomalar",
                nav_add_user: "Foydalanuvchi qo'shish",
                nav_settings: "Profil Sozlamalari",
                nav_sessions: "Faol Qurilmalar",
                nav_logout: "Chiqish",
                platform_title: "LoginGuard Platformasi",
                btn_back: "Ortga qaytish",
                chart_heading: "Kirishlar Statistikasi (Oxirgi 7 kun)",
                chart_success_label: "Muvaffaqiyatli kirishlar",
                chart_failed_label: "Bloklangan / Xato urinishlar"
            },
            en: {
                page_title: "Statistics Chart",
                portal_name: "CYBER PORTAL",
                role_admin: "Administrator",
                role_user: "User",
                nav_dashboard: "Dashboard",
                nav_analytics: "Statistics",
                nav_notifications: "Notifications",
                nav_add_user: "Add User",
                nav_settings: "Settings",
                nav_sessions: "Devices",
                nav_logout: "Logout",
                platform_title: "LoginGuard",
                btn_back: "Back",
                chart_heading: "Login Statistics (Last 7 days)",
                chart_success_label: "Successful Logins",
                chart_failed_label: "Blocked / Failed Attempts"
            },
            ru: {
                page_title: "График Статистики",
                portal_name: "КИБЕР ПОРТАЛ",
                role_admin: "Администратор",
                role_user: "Пользователь",
                nav_dashboard: "Панель",
                nav_analytics: "Статистика",
                nav_notifications: "Уведомления",
                nav_add_user: "Добавить пользователя",
                nav_settings: "Настройки",
                nav_sessions: "Устройства",
                nav_logout: "Выйти",
                platform_title: "LoginGuard",
                btn_back: "Назад",
                chart_heading: "Статистика входов (Последние 7 дней)",
                chart_success_label: "Успешные входы",
                chart_failed_label: "Заблокированные / Ошибочные попытки"
            }
        };

        let currentLang = localStorage.getItem('lang') || 'uz';
        let cyberChartInstance = null;

        // ------------------------------------------
        // GRAFIK CHIZISH KODI
        // ------------------------------------------
        const rawLogs = JSON.parse(document.getElementById('chart-data').dataset.logs);
        const rawFailedLogs = JSON.parse(document.getElementById('chart-data').dataset.failed);
        
        const last7Days = [];
        for (let i = 6; i >= 0; i--) {
            const d = new Date();
            d.setDate(d.getDate() - i);
            last7Days.push(d.toISOString().split('T')[0]);
        }
        
        const successData = Array(7).fill(0);
        const failedData = Array(7).fill(0);

        rawLogs.forEach(log => {
            if(!log.login_time) return;
            const d = new Date(log.login_time + 'Z').toISOString().split('T')[0];
            const idx = last7Days.indexOf(d);
            if(idx !== -1) successData[idx]++;
        });

        rawFailedLogs.forEach(fLog => {
            if(!fLog.attempt_time) return;
            const d = new Date(fLog.attempt_time + 'Z').toISOString().split('T')[0];
            const idx = last7Days.indexOf(d);
            if(idx !== -1) failedData[idx]++;
        });

        const ctx = document.getElementById('cyberChart').getContext('2d');
        cyberChartInstance = new Chart(ctx, {
            type: 'line',
            data: {
                labels: last7Days,
                datasets: [
                    { label: translations[currentLang].chart_success_label, data: successData, borderColor: '#64ffda', backgroundColor: 'rgba(100, 255, 218, 0.1)', borderWidth: 2, fill: true, tension: 0.4 },
                    { label: translations[currentLang].chart_failed_label, data: failedData, borderColor: '#ef4444', backgroundColor: 'rgba(239, 68, 68, 0.1)', borderWidth: 2, fill: true, tension: 0.4 }
                ]
            },
            options: { 
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { labels: { color: '#ccd6f6' } } },
                scales: {
                    x: { ticks: { color: '#8892b0' }, grid: { color: '#233554' } },
                    y: { ticks: { color: '#8892b0', stepSize: 1 }, grid: { color: '#233554' }, beginAtZero: true }
                }
            }
        });

        // Tilni o'zgartirish funksiyasi
        function changeLanguage(lang) {
            currentLang = lang;
            localStorage.setItem('lang', lang);

            // HTML elementlarini tarjima qilish
            document.querySelectorAll('[data-i18n]').forEach(el => {
                const key = el.getAttribute('data-i18n');
                if (translations[lang] && translations[lang][key]) {
                    el.innerText = translations[lang][key];
                }
            });

            // Grafik ichidagi yozuvlarni (Legend) ham yangilash
            if (cyberChartInstance) {
                cyberChartInstance.data.datasets[0].label = translations[lang].chart_success_label;
                cyberChartInstance.data.datasets[1].label = translations[lang].chart_failed_label;
                cyberChartInstance.update();
            }
        }

        // Sahifa yuklanganda tanlangan tilni ishga tushirish
        const langSelect = document.getElementById('languageSelect');
        if (langSelect) langSelect.value = currentLang;
        changeLanguage(currentLang);

        // ==========================================
        // MOBIL MENYUNI OCHISH/YOPISH UCHUN SCRIPT
        // ==========================================
        const menuBtn = document.getElementById('mobile-menu-btn');
        const sidebar = document.querySelector('.sidebar');
        
        if(menuBtn && sidebar) {
            menuBtn.addEventListener('click', function(e) {
                e.stopPropagation();
                sidebar.classList.toggle('active');
            });
            
            document.addEventListener('click', function(e) {
                if(sidebar.classList.contains('active') && !sidebar.contains(e.target) && e.target !== menuBtn) {
                    sidebar.classList.remove('active');
                }
            });
        }
    </script>
</body>
</html>