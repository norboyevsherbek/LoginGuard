<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title data-i18n="page_title">Bildirishnomalar - Kiberxavfsizlik Portali</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root { --bg-body: #0a192f; --bg-sidebar: #112240; --bg-header: #112240; --card-bg: #1e293b; --text-main: #ccd6f6; --text-muted: #8892b0; --accent: #64ffda; --danger: #ef4444; --success: #10b981; --border-color: #233554; }
        [data-theme="light"] { --bg-body: #f1f5f9; --bg-sidebar: #ffffff; --bg-header: #ffffff; --card-bg: #ffffff; --text-main: #0f172a; --text-muted: #64748b; --accent: #3b82f6; --border-color: #e2e8f0; }

        body { margin: 0; font-family: 'Segoe UI', sans-serif; background: var(--bg-body); color: var(--text-main); display: flex; height: 100vh; overflow: hidden; transition: 0.3s; }
        
        .sidebar { width: 260px; background: var(--bg-sidebar) !important; border-right: 1px solid var(--border-color); display: flex; flex-direction: column; z-index: 1000; transition: 0.3s; flex-shrink: 0;}
        .sidebar-header { padding: 20px; font-size: 20px; font-weight: bold; border-bottom: 1px solid var(--border-color); display: flex; align-items: center; justify-content: space-between; }
        .nav-menu { display: flex; flex-direction: column; margin-top: 20px; }
        .nav-item { padding: 12px 20px; display: flex; align-items: center; gap: 15px; color: var(--text-muted); text-decoration: none; font-size: 16px; border-left: 3px solid transparent; }
        .nav-item:hover, .nav-item.active { background: rgba(100, 255, 218, 0.1); color: var(--accent); border-left-color: var(--accent); }
        .nav-item i { width: 20px; text-align: center; }
        
        .main-content { flex: 1; display: flex; flex-direction: column; overflow: hidden; }
        .header { height: 70px; background: var(--bg-header); border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center; padding: 0 40px; font-weight: 600; flex-shrink: 0; transition: 0.3s; }
        .header-controls { display: flex; align-items: center; gap: 20px; }
        
        .content-scroll-area { flex: 1; overflow-y: auto; padding: 30px; }
        
        .notif-card { background: var(--card-bg); border: 1px solid var(--border-color); border-left: 4px solid var(--danger); border-radius: 8px; padding: 20px; margin-bottom: 15px; display: flex; gap: 15px; align-items: flex-start; transition: 0.2s; }
        .notif-card:hover { transform: translateX(5px); box-shadow: 0 5px 15px rgba(0,0,0,0.2); }
        .notif-icon { background: rgba(239, 68, 68, 0.1); color: var(--danger); width: 45px; height: 45px; border-radius: 50%; display: flex; justify-content: center; align-items: center; font-size: 20px; flex-shrink: 0; }
        .notif-content { flex: 1; }
        .notif-title { font-size: 16px; font-weight: bold; margin-bottom: 8px; color: var(--danger); }
        .notif-text { color: var(--text-main); font-size: 14px; margin-bottom: 10px; line-height: 1.5; }
        .notif-time { color: var(--text-muted); font-size: 12px; font-weight: bold; }
        .btn { padding: 10px 18px; border-radius: 6px; cursor: pointer; text-decoration: none; font-size: 14px; display: inline-block; outline: none; border: none; }

        @media (min-width: 769px) { #mobile-menu-btn { display: none !important; } .mobile-only-profile { display: none !important; } }
        @media (max-width: 768px) {
            .header-controls { display: none !important; }
            .header { padding: 15px; height: 70px; }
            #mobile-menu-btn { display: inline-flex !important; position: fixed !important; top: 15px; right: 20px; font-size: 26px; background: transparent; border: none; color: var(--text-main); z-index: 10001 !important; cursor: pointer; }
            .sidebar { position: fixed !important; right: -100% !important; top: 0 !important; width: 280px !important; height: 100vh !important; background-color: var(--bg-sidebar) !important; transition: 0.3s ease !important; z-index: 10000 !important; box-shadow: -5px 0 15px rgba(0,0,0,0.5); border-right: none; }
            .sidebar.active { right: 0 !important; }
            .content-scroll-area { padding: 15px; }
        }
    </style>
</head>
<body>

    <button id="mobile-menu-btn">&#9776;</button>

    <div class="sidebar">
        <div class="sidebar-header">
            <span><i class="fas fa-shield-halved" style="color: var(--danger); margin-right: 10px;"></i> <span data-i18n="portal_name">KIBER PORTAL</span></span>
        </div>
        <div class="mobile-only-profile" style="padding: 20px; border-bottom: 1px solid var(--border-color); display: flex; align-items: center; gap: 15px; background: rgba(0,0,0,0.15);">
            <div style="width: 45px; height: 45px; border-radius: 50%; background: #2c3e50; display: flex; align-items: center; justify-content: center;">
                <% if (typeof user !== 'undefined' && user && user.avatar) { %> <img src="<%= user.avatar %>" style="width:100%; height:100%; border-radius:50%; object-fit:cover;"> <% } else { %> <i class="fas fa-user-shield" style="color: var(--accent); font-size: 22px;"></i> <% } %>
            </div>
            <div>
                <div style="font-weight: bold; color: var(--text-main); font-size: 16px;"><%= (typeof user !== 'undefined' && user) ? user.username : 'Mehmon' %></div>
                <div style="font-size: 12px; color: var(--accent);" data-i18n="<%= (typeof user !== 'undefined' && user && user.role === 'admin') ? 'role_admin' : 'role_user' %>"><%= (typeof user !== 'undefined' && user && user.role === 'admin') ? 'Administrator' : 'Foydalanuvchi' %></div>
            </div>
        </div>
        <div class="nav-menu">
            <a href="/dashboard" class="nav-item"><i class="fas fa-chart-line"></i> <span data-i18n="nav_dashboard">Bosh panel</span></a>
            <a href="/analytics" class="nav-item"><i class="fas fa-chart-area"></i> <span data-i18n="nav_analytics">Statistika</span></a>
            <a href="/notifications" class="nav-item active"><i class="fas fa-bell"></i> <span data-i18n="nav_notifications">Bildirishnomalar</span></a>
            <% if (typeof user !== 'undefined' && user && user.role === 'admin') { %><a href="/admin/add-user" class="nav-item"><i class="fas fa-user-plus"></i> <span data-i18n="nav_add_user">Foydalanuvchi qo'shish</span></a><% } %>
            <a href="/settings" class="nav-item"><i class="fas fa-user-cog"></i> <span data-i18n="nav_settings">Profil Sozlamalari</span></a>
            <a href="/sessions" class="nav-item"><i class="fas fa-laptop-house"></i> <span data-i18n="nav_sessions">Faol Qurilmalar</span></a>
            <a href="/logout" class="nav-item mobile-only-profile" style="color: var(--danger); border-top: 1px solid var(--border-color); margin-top: 10px;"><i class="fas fa-sign-out-alt"></i> <span data-i18n="nav_logout">Chiqish</span></a>
        </div>
    </div>
    
    <div class="main-content">
        <div class="header">
            <div><i class="fas fa-bell" style="color:var(--danger);"></i> <span data-i18n="header_title">Bildirishnomalar oynasi</span></div>
            <div class="header-controls">
                <select id="languageSelect" onchange="changeLanguage(this.value)" style="background:var(--card-bg); color:var(--text-main); border:1px solid var(--border-color); border-radius:4px; outline:none; padding: 5px; cursor:pointer;">
                    <option value="uz">UZB</option>
                    <option value="en">ENG</option>
                    <option value="ru">RUS</option>
                </select>
                <a href="/dashboard" style="color:var(--accent); text-decoration:none;"><i class="fas fa-arrow-left"></i> <span data-i18n="btn_back">Ortga qaytish</span></a>
            </div>
        </div>
        
        <div class="content-scroll-area">
            <div style="max-width: 900px; margin: 0 auto;">
                
                <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 25px; flex-wrap: wrap; gap: 15px;">
                    <div>
                        <h2 style="color: var(--text-main); margin-top: 0; margin-bottom: 8px;"><i class="fas fa-exclamation-triangle" style="color: var(--danger);"></i> <span data-i18n="sec_title">Xavfsizlik ogohlantirishlari</span></h2>
                        <p style="color: var(--text-muted); margin: 0;" data-i18n="sec_desc">Tizimga noqonuniy kirishga urinishlar va xato parollar tarixi.</p>
                    </div>
                    
                    <% if (typeof notifications !== 'undefined' && notifications && notifications.length > 0) { %>
                        <form action="/clear-notifications" method="POST">
                            <button type="submit" class="btn" style="background: rgba(239, 68, 68, 0.1); color: var(--danger); font-weight: bold; border: 1px solid rgba(239, 68, 68, 0.3); transition: 0.3s;" onmouseover="this.style.background='var(--danger)'; this.style.color='white';" onmouseout="this.style.background='rgba(239, 68, 68, 0.1)'; this.style.color='var(--danger)';">
                                <i class="fas fa-trash-alt"></i> <span data-i18n="btn_clear">Barchasini tozalash</span>
                            </button>
                        </form>
                    <% } %>
                </div>
                
                <% if (typeof notifications !== 'undefined' && notifications && notifications.length > 0) { %>
                    <% notifications.forEach(n => { %>
                        <div class="notif-card" style="margin-bottom: 15px; padding: 15px; background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 8px; display: flex; align-items: flex-start; gap: 15px;">
                            <div class="notif-icon"><i class="fas fa-shield-cat" style="font-size: 24px; color: var(--danger);"></i></div>
                            <div class="notif-content" style="flex: 1;">
                                <div class="notif-title" style="font-weight: bold; color: var(--text-main); margin-bottom: 5px;"><%= n.title %></div>
                                <div class="notif-text" style="color: var(--text-muted); font-size: 14px; margin-bottom: 8px;"><%- n.msg %></div>
                                
                                <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px;">
                                    <div class="notif-time" style="font-size: 12px; color: var(--text-muted);"><i class="fas fa-clock"></i> <%= n.time ? new Date(n.time + 'Z').toLocaleString('uz-UZ') : '' %></div>
                                    
                                    <!-- Tezkor IP Bloklash tugmasi -->
                                    <% if (typeof user !== 'undefined' && user && user.role === 'admin' && n.ip) { %>
                                        <form action="/admin/block-ip" method="POST" style="margin: 0;">
                                            <input type="hidden" name="ip_address" value="<%= n.ip %>">
                                            <button type="submit" style="background: rgba(239, 68, 68, 0.15); color: var(--danger); border: 1px solid var(--danger); padding: 5px 12px; border-radius: 5px; cursor: pointer; font-size: 12px; font-weight: bold; display: inline-flex; align-items: center; gap: 5px; transition: 0.2s;">
                                                <i class="fas fa-ban"></i> IP-ni Bloklash (<%= n.ip %>)
                                            </button>
                                        </form>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div style="padding: 40px; text-align: center; color: var(--success); font-size: 18px; background: var(--card-bg); border-radius: 10px; border: 1px dashed var(--success);" data-i18n="no_notifs">
                        <i class="fas fa-check-circle" style="font-size: 40px; margin-bottom: 15px; display: block;"></i>
                        Yangi xavflar aniqlanmadi! Tizimingiz xavfsiz.
                    </div>
                <% } %>

            </div>
        </div>
    </div>

    <script>
        document.documentElement.setAttribute('data-theme', localStorage.getItem('theme') || 'dark');

        const translations = {
            uz: {
                page_title: "Bildirishnomalar - Kiberxavfsizlik Portali",
                portal_name: "KIBER PORTAL",
                role_admin: "Administrator",
                role_user: "Foydalanuvchi",
                nav_dashboard: "Bosh panel",
                nav_analytics: "Statistika",
                nav_notifications: "Bildirishnomalar",
                nav_add_user: "Foydalanuvchi qo'shish",
                nav_settings: "Profil Sozlamalari",
                nav_sessions: "Faol Qurilmalar",
                nav_logout: "Chiqish",
                header_title: "Bildirishnomalar oynasi",
                btn_back: "Ortga qaytish",
                sec_title: "Xavfsizlik ogohlantirishlari",
                sec_desc: "Tizimga noqonuniy kirishga urinishlar va xato parollar tarixi.",
                btn_clear: "Barchasini tozalash",
                no_notifs: "Yangi xavflar aniqlanmadi! Tizimingiz xavfsiz."
            },
            en: {
                page_title: "Notifications - Cyber Security Portal",
                portal_name: "CYBER PORTAL",
                role_admin: "Administrator",
                role_user: "User",
                nav_dashboard: "Dashboard",
                nav_analytics: "Statistics",
                nav_notifications: "Notifications",
                nav_add_user: "Add User",
                nav_settings: "Settings",
                nav_sessions: "Devices",
                nav_logout: "Logout",
                header_title: "Notifications Window",
                btn_back: "Back",
                sec_title: "Security Alerts",
                sec_desc: "History of unauthorized login attempts and incorrect passwords.",
                btn_clear: "Clear All",
                no_notifs: "No new threats detected! Your system is secure."
            },
            ru: {
                page_title: "Уведомления - Портал Кибербезопасности",
                portal_name: "КИБЕР ПОРТАЛ",
                role_admin: "Администратор",
                role_user: "Пользователь",
                nav_dashboard: "Панель",
                nav_analytics: "Статистика",
                nav_notifications: "Уведомления",
                nav_add_user: "Добавить пользователя",
                nav_settings: "Настройки",
                nav_sessions: "Устройства",
                nav_logout: "Выйти",
                header_title: "Окно уведомлений",
                btn_back: "Назад",
                sec_title: "Предупреждения безопасности",
                sec_desc: "История попыток несанкционированного входа и неверных паролей.",
                btn_clear: "Очистить все",
                no_notifs: "Новых угроз не обнаружено! Ваша система в безопасности."
            }
        };

        let currentLang = localStorage.getItem('lang') || 'uz';

        function changeLanguage(lang) {
            currentLang = lang;
            localStorage.setItem('lang', lang);

            document.querySelectorAll('[data-i18n]').forEach(el => {
                const key = el.getAttribute('data-i18n');
                if (translations[lang] && translations[lang][key]) {
                    el.innerText = translations[lang][key];
                }
            });
        }

        const langSelect = document.getElementById('languageSelect');
        if (langSelect) langSelect.value = currentLang;
        changeLanguage(currentLang);

        const menuBtn = document.getElementById('mobile-menu-btn');
        const sidebar = document.querySelector('.sidebar');
        if(menuBtn && sidebar) {
            menuBtn.addEventListener('click', function(e) {
                e.stopPropagation(); sidebar.classList.toggle('active');
            });
            document.addEventListener('click', function(e) {
                if(sidebar.classList.contains('active') && !sidebar.contains(e.target) && e.target !== menuBtn) sidebar.classList.remove('active');
            });
        }
    </script>
</body>
</html>